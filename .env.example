# Copy this file to .env.local and adjust values before running the app.

# Username and password for the first admin account, created the very
# first time the app starts. Add more staff logins later from
# Admin > Staff, and change any account's password from Admin > Settings.
# These env vars only matter on that first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign the admin login session cookie. Use a long random
# string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-this-to-a-long-random-string
