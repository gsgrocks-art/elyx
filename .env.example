# Copy this file to .env.local and adjust values before running the app.

# Password for the admin panel on first run. Change it later from
# Admin > Settings, which stores a hashed password in the database
# instead. This value only matters the very first time the app starts
# and creates the database.
ADMIN_PASSWORD=admin123

# Secret used to sign the admin login session cookie. Use a long random
# string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-this-to-a-long-random-string
